# =============================================================================
# KrishiConnect Backend Environment Variables
# =============================================================================

# Database Configuration (Supabase PostgreSQL)
# Example Direct Connection:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Example Connection Pooler (PgBouncer):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Supabase API Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLIC_KEY=your-supabase-public-anon-key

# JWT & Security Configuration
SECRET_KEY=krishiconnect-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OPERATOR_REG_SECRET=krishi-admin-2026

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SMS Gateway Configuration (Twilio GSM Carrier & Fast2SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number
FAST2SMS_API_KEY=your_fast2sms_api_key_optional
